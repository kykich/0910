# Нормализация окончаний строк: при checkout — нативные для ОС,
# в репозитории хранятся LF. Это исключает массовые «переписывания»
# строк при каждом stage (проблема core.autocrlf).
* text=auto

# Для кода и разметки привычно хранить LF всегда.
*.py       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf

# Скрипты для Linux ОБЯЗАНЫ быть с LF: CRLF ломает shebang (bash: bad
# interpreter / \r: command not found). Сюда попадают любые shell-скрипты.
*.sh       text eol=lf
# Скрипты/юниты деплоя без расширения .sh тоже держим с LF (по eol в autodetect
# они могут получить CRLF — для systemd/скриптов это критично).
deploy/*   text eol=lf

# Бинарные файлы не трогаем.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.tif      binary
*.tiff     binary

